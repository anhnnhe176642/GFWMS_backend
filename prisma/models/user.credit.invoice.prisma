model CreditInvoice{
    id          Int       @id @default(autoincrement())
    
    totalCreditAmount Float @default(0)
    creditPaidAmount Float @default(0)

    dueDate     DateTime

    status      CreditInvoiceStatus @default(PENDING)

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    creditId    Int
    credit CreditRegistration @relation(fields: [creditId],references: [id])

    invoice Invoice[]
    payment Payment[]  @relation("CreditInvoicePayments")
}