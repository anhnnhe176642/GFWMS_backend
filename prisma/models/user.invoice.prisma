model Invoice {
    id          Int       @id @default(autoincrement())
    orderId     Int       @unique
    order       Order     @relation(fields: [orderId], references: [id])
    invoiceDate DateTime  @default(now())
    invoiceStatus InvoiceStatus @default(UNPAID)
    totalAmount Float     
    notes       String?   @db.VarChar(255)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    
    paymentType       PaymentType  @default(CASH)
    paymentDeadline   DateTime?

    creditAmount    Float     @default(0)  // Số tiền ghi nợ
    paidAmount      Float     @default(0)  // Số tiền đã thanh toán

    payment     Payment?

    creditInvoiceId Int?
    creditInvoice CreditInvoice? @relation(fields: [creditInvoiceId], references: [id])
}