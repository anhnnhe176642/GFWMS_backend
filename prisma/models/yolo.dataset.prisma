// YOLO Dataset Management Models
// Stores labeled training data for YOLO model training

enum YoloDatasetImageStatus {
  PENDING        // Đang chờ
  PROCESSING     // Đang xử lí
  COMPLETED      // Hoàn thành
  FAILED         // Thất bại
}

model YoloDataset {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  
  // Dataset metadata
  totalImages   Int      @default(0)
  totalLabels   Int      @default(0)
  classes       Json     @default("[]") // Array of class names
  
  // Storage paths
  datasetPath   String   // Path to dataset folder
  
  // Status and versioning
  status        YoloDatasetStatus @default(ACTIVE)
  
  // Relations
  images        YoloDatasetImage[]
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([status])
  @@index([createdAt])
}

model YoloDatasetImage {
  id            String   @id @default(cuid())
  datasetId     String
  dataset       YoloDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  
  // Image information
  filename      String
  imagePath     String   // Relative path to image file
  width         Int
  height        Int
  format        String?  // jpg, png, etc.
  
  objectCount   Int      @default(0)
  classes       Json     @default("[]") // Array of class IDs in this image
  
  // Annotations (pixel format) - Source of truth
  // Array of: {class_id, class_name, x1, y1, x2, y2, confidence}
  // x1, y1 = top-left corner; x2, y2 = bottom-right corner (pixel coordinates)
  annotations   Json     @default("[]")
  
  // Status tracking
  status        YoloDatasetImageStatus @default(PENDING)
  
  // Metadata
  uploadedBy    String?
  uploadedByUser User? @relation(fields: [uploadedBy], references: [id])
  notes         String?
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([datasetId])
  @@index([createdAt])
  @@index([status])
  @@unique([datasetId, filename])
}
