# Database configuration
DATABASE_URL="mysql://user:password@localhost:3306/dbname"

# Server port
PORT=3000

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM="Warehouse Fabric System <noreply@warehouse-fabric-system.com>"

# Frontend URL (for verification link)
FRONTEND_URL=http://localhost:5173

# Email verification PIN configuration
# Expiration time in minutes for the numeric PIN
VERIFY_PIN_EXPIRES_MINUTES=5
# Maximum verification attempts before invalidating PIN
VERIFY_PIN_MAX_ATTEMPTS=5
# Cooldown (seconds) between resending verification PINs
VERIFY_PIN_RESEND_COOLDOWN_SECONDS=60

# Password reset PIN configuration
# Expiration time in minutes for password reset PIN
PASSWORD_RESET_PIN_EXPIRES_MINUTES=5
# Maximum attempts for password reset PIN before invalidation
PASSWORD_RESET_PIN_MAX_ATTEMPTS=5

# Environment
NODE_ENV="development"

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key

# ============================================================
# Mock Data Configuration
# Số lượng bản ghi tạo cho mỗi lần chạy: pnpm run mock
# Để trống hoặc xóa để sử dụng giá trị mặc định
# ============================================================
MOCK_USERS=200                      # Số user tạo
MOCK_FABRIC_CATEGORIES=5         # Số loại vải
MOCK_FABRIC_COLORS=5              # Số màu vải
MOCK_FABRIC_GLOSS=5                # Số độ bóng vải
MOCK_SUPPLIERS=5                  # Số nhà cung cấp
MOCK_WAREHOUSES=10                  # Số kho
MOCK_STORES=10                      # Số cửa hàng
MOCK_FABRICS=1000                    # Số sản phẩm vải
MOCK_SHELVES_PER_WAREHOUSE=10      # Số kệ cho mỗi kho
MOCK_IMPORT_FABRICS=100             # Số phiếu nhập kho
MOCK_IMPORT_ITEMS_PER_IMPORT=50      # Số item cho mỗi phiếu nhập
MOCK_EXPORT_FABRICS=100             # Số phiếu xuất kho
MOCK_EXPORT_ITEMS_PER_EXPORT=10     # Số item cho mỗi phiếu xuất
MOCK_FABRIC_SHELVES=10000           # Số quan hệ vải-kệ
MOCK_FABRIC_STORES=350              # Số quan hệ vải-cửa hàng
MOCK_ORDERS=200                     # Số đơn hàng
MOCK_ORDER_ITEMS_PER_ORDER=3        # Số item cho mỗi đơn hàng
MOCK_INVOICE_PERCENTAGE=0.9         # Tỉ lệ đơn hàng có hóa đơn (0.0 - 1.0)
MOCK_PAYMENT_PERCENTAGE=0.8         # Tỉ lệ hóa đơn đã thanh toán (0.0 - 1.0)
