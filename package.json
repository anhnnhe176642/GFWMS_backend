{
  "name": "sep2025",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "init": "pnpm i && pnpm run prisma:all && pnpm run seed",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest --reporter=verbose",
    "seed": "node prisma/seed.js",
    "prisma:merge": "npx prisma-merge --baseFile=prisma/schema.prisma --schemaFilePatterns=prisma/**/*.prisma --outputFile=prisma/schema.merged.prisma",
    "prisma:gen": "pnpm run prisma:merge && npx prisma generate --schema=prisma/schema.merged.prisma",
    "prisma:migrate": "pnpm run prisma:merge && npx prisma migrate dev --schema=prisma/schema.merged.prisma",
    "prisma:all": "pnpm run prisma:merge && npx prisma generate --schema=prisma/schema.merged.prisma && npx prisma db push --schema=prisma/schema.merged.prisma && pnpm run prisma:cleanup",
    "prisma:cleanup": "node -e \"try{require('fs').unlinkSync('prisma/schema.merged.prisma')}catch(e){}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.9",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.4.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "nodemon": "^3.1.10",
    "prisma-merge": "^0.2.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
